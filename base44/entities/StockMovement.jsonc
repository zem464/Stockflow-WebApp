{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "item_name": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "adjusted",
        "edited",
        "deleted"
      ]
    },
    "quantity_change": {
      "type": "number"
    },
    "quantity_after": {
      "type": "number"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "item_name",
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}