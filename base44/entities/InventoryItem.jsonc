{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "cost_per_item": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "menu_price": {
      "type": "number"
    },
    "available_on_menu": {
      "type": "boolean",
      "default": false
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 5
    }
  },
  "required": [
    "name",
    "quantity",
    "cost_per_item"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}