{
  "name": "SalesRecord",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "item_name": {
      "type": "string"
    },
    "quantity_sold": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    }
  },
  "required": [
    "date",
    "item_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}